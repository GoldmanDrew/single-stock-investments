{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Short Alpha Ledger",
  "type": "object",
  "required": ["schema_version", "as_of", "frameworks", "source_types", "ideas"],
  "properties": {
    "schema_version": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "currency": {"type": "string"},
    "frameworks": {"type": "array", "items": {"type": "object", "required": ["id", "label", "question"]}},
    "source_types": {"type": "array", "items": {"type": "object", "required": ["id", "label"]}},
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "security_name", "instrument_type", "position", "frameworks", "primary_framework", "hypothesis", "catalysts", "falsifiers", "research", "sources", "check_ins"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.\\-]+$"},
          "instrument_type": {"enum": ["operating_company", "holding_company", "leveraged_etf", "etf", "closed_end_fund", "other"]},
          "position": {
            "type": "object",
            "required": ["shares", "opened_price", "opened_date", "split_adjustment_factor"],
            "properties": {
              "shares": {"type": "number", "exclusiveMaximum": 0},
              "opened_price": {"type": "number", "exclusiveMinimum": 0},
              "opened_date": {"type": "string", "format": "date"},
              "split_adjustment_factor": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "frameworks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "object", "required": ["type", "label"]}},
          "check_ins": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "price", "hypothesis_state", "note"]}}
        }
      }
    }
  }
}
