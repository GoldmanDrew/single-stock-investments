        {"id": "wti_crude", "label": "WTI crude (USD/bbl)", "source": "fred", "fred_id": "DCOILWTICO", "good_for": "royalty_price", "fallback": {"source": "yahoo_daily", "yahoo_symbol": "CL=F"}},
        {"id": "henry_hub_gas", "label": "Henry Hub natural gas spot (USD/MMBtu)", "source": "fred", "fred_id": "DHHNGSP", "good_for": "gas_royalty_price", "fallback": {"source": "yahoo_daily", "yahoo_symbol": "NG=F"}},
        {"id": "permian_crude_production_mbbl_d", "label": "Permian crude / oil-gas activity proxy", "source": "eia", "eia_route": "petroleum/crd/crpdn", "eia_facets": {"duoarea": "RTPP", "product": "EPC0", "process": "FPF"}, "good_for": "royalty_volume", "optional": true, "staleness_max_days": 60, "fallback": {"source": "fred", "fred_id": "IPN213111S", "note": "US oil and gas extraction IP proxy"}}
