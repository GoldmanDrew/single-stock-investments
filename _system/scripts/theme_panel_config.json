        {"id": "building_permits", "label": "US building permits (thousands, SAAR)", "source": "fred", "fred_id": "PERMIT", "good_for": "housing_pipeline", "staleness_max_days": 60},
        {"id": "ust_10y", "label": "US Treasury 10Y yield (%)", "source": "fred", "fred_id": "DGS10", "good_for": "mortgage_discount", "fallback": {"source": "yahoo_daily", "yahoo_symbol": "^TNX"}}
