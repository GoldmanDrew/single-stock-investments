        {"id": "vix_level", "label": "VIX index level", "source": "fred", "fred_id": "VIXCLS", "good_for": "vol_regime", "fallback": {"source": "yahoo_daily", "yahoo_symbol": "^VIX"}},
        {"id": "spy_20d_realized_vol", "label": "SPY 20-day realized vol (annualized %)", "source": "computed_realized_vol", "ticker": "SPY", "window_days": 20, "good_for": "equity_vol"},
        {"id": "n225_20d_realized_vol", "label": "Nikkei 225 20-day realized vol (annualized %)", "source": "computed_realized_vol", "ticker": "^N225", "window_days": 20, "good_for": "equity_vol_jp"},
        {"id": "hsi_20d_realized_vol", "label": "Hang Seng 20-day realized vol (annualized %)", "source": "computed_realized_vol", "ticker": "^HSI", "window_days": 20, "good_for": "equity_vol_hk"},
        {"id": "asx200_20d_realized_vol", "label": "ASX 200 20-day realized vol (annualized %)", "source": "computed_realized_vol", "ticker": "^AXJO", "window_days": 20, "good_for": "equity_vol_au"},
        {"id": "ftse_20d_realized_vol", "label": "FTSE 100 20-day realized vol (annualized %)", "source": "computed_realized_vol", "ticker": "^FTSE", "window_days": 20, "good_for": "equity_vol_uk"},
        {"id": "stoxx50_20d_realized_vol", "label": "Euro Stoxx 50 20-day realized vol (annualized %)", "source": "computed_realized_vol", "ticker": "^STOXX50E", "window_days": 20, "good_for": "equity_vol_eu"},
        {"id": "vrp_health_score", "label": "VRP health score (etf-dashboard derived 0-100)", "source": "etf_dashboard_snapshot", "snapshot_file": "vrp_health.json", "json_path": "health_score", "derive": "vrp_health_score", "good_for": "options_market_health", "optional": true},
        {"id": "vol_term_slope", "label": "Vol term-structure slope (VIX3M - VIX)", "source": "computed_vix_term_slope", "good_for": "vol_term_structure", "optional": true, "note": "Positive = contango; negative = inversion stress. Replaces obsolete vol_shape latest.slope path."}
      ]
    },
    "water_surface": {
      "label": "Permian / Southwest water & surface rights",
      "description": "Produced-water and surface royalties midstream of oil activity and land scarcity.",
      "series": [
        {"id": "tpl_water_revenue_m", "label": "TPL water segment revenue (USD m, FY)", "source": "filing_panel", "panel": "tpl_operating_panel.csv", "metric": "water_revenue_m", "good_for": "water_infra_proof", "staleness_max_days": 400},
        {"id": "wti_crude", "label": "WTI crude (USD/bbl)", "source": "fred", "fred_id": "DCOILWTICO", "good_for": "permian_cashflow", "fallback": {"source": "yahoo_daily", "yahoo_symbol": "CL=F"}},
        {"id": "permian_crude_production_mbbl_d", "label": "Permian crude / oil-gas activity proxy", "source": "eia", "eia_route": "petroleum/crd/crpdn", "eia_facets": {"duoarea": "RTPP", "product": "EPC0", "process": "FPF"}, "good_for": "permian_volume", "optional": true, "staleness_max_days": 60, "fallback": {"source": "fred", "fred_id": "IPN213111S", "note": "US oil and gas extraction IP proxy"}},
        {"id": "hyperscaler_capex_ttm_usd_bn", "label": "Hyperscaler capex guide (USD bn, latest)", "source": "repo_valuation", "good_for": "land_power_demand"}
