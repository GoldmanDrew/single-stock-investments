{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_calibration_receipt_schema.json",
  "title": "Analysis calibration consumption receipt",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "input_sha",
    "calibration_release_hash",
    "challenge_applied",
    "analysis_changed",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"type": "string", "minLength": 1},
    "input_sha": {"type": "string", "minLength": 7},
    "calibration_release_hash": {"type": ["string", "null"]},
    "challenge_applied": {"type": "boolean"},
    "analysis_changed": {"type": "boolean"},
    "change_summary": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
