{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valuation workbench",
  "type": "object",
  "required": ["schema_version", "ticker", "as_of", "proof_status", "model_level", "decision_eligibility", "dates", "legacy_audit", "decision", "business", "valuation", "optionality", "committee", "evidence", "method_fit", "outcomes", "attribution", "freshness"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "ticker": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "proof_status": {"enum": ["decision_grade", "evidence_blocked"]},
    "model_level": {"enum": ["unmodeled", "evidence_blocked", "screening_grade", "stock_specific", "committee_reviewed", "owner_approved"]},
    "decision_eligibility": {"type": "object"},
    "dates": {"type": "object"},
    "legacy_audit": {"type": "object"},
    "decision": {
      "type": "object",
      "required": ["status", "proof_status", "model_level", "return_publishable", "value_per_share", "present_value_today_per_share", "margin_of_safety_pct", "forward_return_at_price_pct", "unvalued_component_count", "unresolved_evidence_count"],
      "properties": {
        "model_level": {"enum": ["unmodeled", "evidence_blocked", "screening_grade", "stock_specific", "committee_reviewed", "owner_approved"]},
        "return_publishable": {"type": "boolean"},
        "output_basis": {"type": ["string", "null"]},
        "forward_return_status": {"enum": ["available", "withheld"]}
      }
    },
    "business": {"type": "object", "required": ["status", "components", "component_coverage", "facts", "estimates", "judgments"]},
    "valuation": {"type": "object", "required": ["status", "market", "valuation", "components", "scenario_contract", "calculation_proof_summary", "model_checks", "source_lineage", "change_control"]},
    "optionality": {"type": "object", "required": ["status", "option_count", "options", "rule"]},
    "committee": {
      "type": "object",
      "required": ["status", "analysis_progress", "next_action"],
      "properties": {
        "status": {"enum": ["not_started", "evidence_blocked", "parked", "independent_review_open", "ready_to_assemble", "owner_decision_pending", "outcome_tracking"]},
        "analysis_progress": {
          "type": "object",
          "required": ["completed", "required"],
          "properties": {"completed": {"type": "integer", "minimum": 0}, "required": {"type": "integer", "minimum": 0}}
        },
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {"type": "object", "required": ["status", "gaps"], "properties": {"status": {"type": "string"}, "gaps": {"type": "array"}}},
    "method_fit": {"type": "object", "required": ["profile_id", "label", "applicability_tests", "failure_modes"]},
    "outcomes": {"type": "object", "required": ["status", "schedule", "minimum_persona_outcomes_before_reweighting"]},
    "attribution": {"type": "object", "required": ["status", "current"]},
    "freshness": {"type": "object", "required": ["status", "dates", "age_days", "warnings"]}
  },
  "additionalProperties": true
}
