[Unit]
Description=Back up portfolio hub SQLite ledger

[Service]
Type=oneshot
User=portfolio-hub
WorkingDirectory=/opt/single-stock-investments
ExecStart=/opt/portfolio-hub-venv/bin/python -m _system.trading.portfolio_hub --db /var/lib/portfolio-hub/portfolio.db backup --output-dir /var/lib/portfolio-hub/backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/portfolio-hub

# CLAUDE.md rule 7 (IB Gateway coexistence): background job on the NY4 box that
# also runs the SPX 0DTE executor. Niced and CPU-capped so SPX never waits
# behind it for a core.
Nice=15
CPUQuota=30%
IOSchedulingClass=idle
