[Unit]
Description=Magis portfolio hub IBKR collector
After=network-online.target ibgateway.service

[Service]
Type=simple
User=portfolio-hub
WorkingDirectory=/opt/single-stock-investments
EnvironmentFile=/etc/portfolio-hub/portfolio-hub.env
ExecStart=/opt/portfolio-hub-venv/bin/python -m _system.trading.portfolio_hub --db /var/lib/portfolio-hub/portfolio.db collect
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/portfolio-hub

# CLAUDE.md rule 7 (IB Gateway coexistence): this is a background job on the
# NY4 box that also runs the SPX 0DTE executor. Niced and CPU-capped so SPX
# never waits behind it for a core.
Nice=15
CPUQuota=50%
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
