[Unit]
Description=Publish private portfolio projection
After=network-online.target portfolio-hub-collector.service

[Service]
Type=oneshot
User=portfolio-hub
WorkingDirectory=/opt/single-stock-investments
EnvironmentFile=/etc/portfolio-hub/portfolio-hub.env
ExecStart=/opt/portfolio-hub-venv/bin/python -m _system.trading.portfolio_hub --db /var/lib/portfolio-hub/portfolio.db publish-latest --account ${IBKR_ACCOUNT_ALIAS}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/portfolio-hub
