[Unit]
# The order bridge: IBKR client 91, the hub's sole transmitter.
#
# This file replaces deploy/portfolio-hub-bridge.service, which targets
# /opt/single-stock-investments under a `portfolio-hub` system user. That layout
# does not exist. The real install is /home/spx under spx's *user* systemd, which
# is invisible to `systemctl list-units` -- see CLAUDE.md. Units in this
# directory match what is actually on the box; the ones a level up do not.
#
# Deliberately NOT ordered After=ibc.service. ibc is a session service that
# exits 0/SUCCESS after the close and is down all weekend, so binding to it
# would stop the bridge every evening. The bridge instead fails to connect,
# backs off, and returns when the Gateway does.
Description=Magis portfolio hub order bridge (IBKR client 91, sole transmitter)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/spx/single-stock-investments
EnvironmentFile=/home/spx/.config/portfolio-hub/secrets.env
Environment=PYTHONPATH=/home/spx/single-stock-investments

# --route paper is the whole point of the first deployment.
#
# It still connects to the Gateway on client 91 and still uses real IBKR data --
# live NBBO for the price band, real whatIf margin, real contract resolution --
# but fills land in the paper ledger and placeOrder is never called. Moving to
# --route live is a separate, deliberate edit, reviewed on its own.
#
# Three further interlocks live in secrets.env and all default to off:
#   PORTFOLIO_LIVE_ENABLED=0     a mode=live ticket is rejected
#   PORTFOLIO_OPTIONS_ENABLED=0  an OPT ticket is rejected
#   PORTFOLIO_KILL_SWITCH=0      set to 1 to refuse everything immediately
ExecStart=/home/spx/portfolio-hub-venv/bin/python -m _system.trading.portfolio_hub \
  --db /home/spx/portfolio-hub/portfolio.db \
  order-bridge --account ${IBKR_ACCOUNT_ALIAS} --route paper

# Reconnect across IB Gateway's daily restart rather than dying with it. The
# bridge re-runs ownership recovery on every start before accepting work, so a
# restart is safe. RestartSec=60, not the stock 5: a refused connection to
# 127.0.0.1:4002 is *normal* off-hours, and at 5s the collector once produced
# 6,785 restarts and ~315k journal lines against a Gateway that was down on
# purpose (CLAUDE.md rule 7/8).
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=600
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-hub-bridge

# NOT niced or CPU-capped, unlike every other hub unit.
#
# CLAUDE.md rule 7 exists so background batch work cannot make the SPX executor
# wait for a core. This process cancels and (eventually) transmits live orders on
# a 1s poll while a ticket is open; delaying it to protect CPU would trade a real
# execution risk for a theoretical one. It is a single low-duty-cycle poller, not
# a backfill, so it cannot starve SPX the way a collector or Whisper job can.

[Install]
WantedBy=default.target
