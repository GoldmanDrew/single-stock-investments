{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magis.internal/contracts/portfolio/allocation_projection.v1.schema.json",
  "title": "Allocation and reconciliation projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "source_run_id", "account_alias", "as_of", "allocations", "cash_events", "reconciliation_breaks", "order_events"],
  "properties": {
    "schema_version": {"const": "allocation_projection.v1"},
    "projection_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "account_alias": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "allocations": {"type": "array", "items": {"type": "object"}},
    "cash_events": {"type": "array", "items": {"type": "object"}},
    "reconciliation_breaks": {"type": "array", "items": {"type": "object"}},
    "order_events": {"type": "array", "items": {"type": "object"}}
  }
}
