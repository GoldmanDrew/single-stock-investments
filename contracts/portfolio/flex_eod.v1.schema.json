{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magis.internal/contracts/portfolio/flex_eod.v1.schema.json",
  "title": "IBKR Flex completed-session ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_run_id", "account_alias", "session_date", "as_of", "positions", "trades", "cash_transactions", "nav_rows"],
  "properties": {
    "schema_version": {"const": "flex_eod.v1"},
    "source_run_id": {"type": "string"},
    "account_alias": {"type": "string"},
    "session_date": {"type": "string", "format": "date"},
    "as_of": {"type": "string", "format": "date-time"},
    "positions": {"type": "array", "items": {"type": "object"}},
    "trades": {"type": "array", "items": {"type": "object"}},
    "cash_transactions": {"type": "array", "items": {"type": "object"}},
    "nav_rows": {"type": "array", "items": {"type": "object"}}
  }
}
