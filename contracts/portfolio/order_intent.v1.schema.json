{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magis.internal/contracts/portfolio/order_intent.v1.schema.json",
  "title": "Guarded order intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_uuid", "account_alias", "conid", "action", "quantity", "limit_price", "tif", "owner", "strategy", "mode"],
  "properties": {
    "schema_version": {"const": "order_intent.v1"},
    "intent_uuid": {"type": "string", "format": "uuid"},
    "account_alias": {"type": "string"},
    "conid": {"type": "integer", "minimum": 1},
    "contract_fingerprint": {"type": "string", "minLength": 1},
    "action": {"enum": ["BUY", "SELL"]},
    "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "limit_price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "tif": {"enum": ["DAY", "GTC"]},
    "outside_rth": {"type": "boolean"},
    "reduce_only": {"type": "boolean"},
    "owner": {"enum": ["drew", "michael", "unallocated"]},
    "strategy": {"type": "string"},
    "mode": {"enum": ["dry_run", "paper", "live"]}
  }
}
