{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magis.internal/contracts/portfolio/position.v1.schema.json",
  "title": "Canonical broker position v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_alias", "conid", "model_code", "symbol", "sec_type", "currency", "base_currency", "quantity", "quantity_unit", "source", "as_of"],
  "properties": {
    "account_alias": {"type": "string", "minLength": 1},
    "conid": {"type": "integer", "minimum": 1},
    "model_code": {"type": "string"},
    "symbol": {"type": "string", "minLength": 1},
    "local_symbol": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "sec_type": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "base_currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "native_currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "exchange": {"type": ["string", "null"]},
    "expiry": {"type": ["string", "null"]},
    "strike": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "right": {"type": ["string", "null"]},
    "multiplier": {"type": ["string", "null"]},
    "quantity": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "quantity_unit": {"enum": ["shares", "contracts", "units", "cash"]},
    "average_cost": {"type": ["string", "null"]},
    "mark": {"type": ["string", "null"]},
    "market_value": {"type": ["string", "null"]},
    "unrealized_pnl": {"type": ["string", "null"]},
    "realized_pnl": {"type": ["string", "null"]},
    "daily_pnl": {"type": ["string", "null"]},
    "average_cost_native": {"type": ["string", "null"]},
    "mark_native": {"type": ["string", "null"]},
    "market_value_native": {"type": ["string", "null"]},
    "market_value_base": {"type": ["string", "null"]},
    "unrealized_pnl_base": {"type": ["string", "null"]},
    "realized_pnl_base": {"type": ["string", "null"]},
    "daily_pnl_base": {"type": ["string", "null"]},
    "fx_rate_to_base": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "fx_as_of": {"type": ["string", "null"], "format": "date-time"},
    "fx_source": {
      "description": "How native was translated to base. 'identity' is a same-currency row; 'ibkr_portfolio_translation' is the rate implied by marketValue/marketPrice; 'fx_unavailable' means the rate was underivable (zero mark or flat row) and fx_rate_to_base is null, which degrades the row's quality rather than failing the snapshot.",
      "enum": ["identity", "ibkr_portfolio_translation", "fx_unavailable", null]
    },
    "source": {"enum": ["ibkr_live", "ibkr_flex"]},
    "as_of": {"type": "string", "format": "date-time"},
    "quality": {"enum": ["live", "delayed", "estimated", "unknown"]}
  }
}
