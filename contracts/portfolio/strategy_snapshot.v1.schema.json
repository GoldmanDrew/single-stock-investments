{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magis.internal/contracts/portfolio/strategy_snapshot.v1.schema.json",
  "title": "Strategy producer snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "source_run_id", "as_of", "complete", "rows"],
  "properties": {
    "schema_version": {"const": "strategy_snapshot.v1"},
    "producer": {"enum": ["spx_0dte", "ls_risk", "ls_bucket5_live", "ls_bucket5_product"]},
    "source_run_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "supported_scopes": {"type": "array", "items": {"enum": ["account", "owner", "strategy", "bucket"]}},
    "summary": {"type": "object"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row_id", "strategy", "reconciliation_role", "exposure_basis", "metrics"],
        "properties": {
          "row_id": {"type": "string"},
          "account_alias": {"type": ["string", "null"]},
          "conid": {"type": ["integer", "null"]},
          "model_code": {"type": ["string", "null"]},
          "symbol": {"type": ["string", "null"]},
          "underlying": {"type": ["string", "null"]},
          "strategy": {"type": "string"},
          "bucket": {"type": ["string", "null"]},
          "product_class": {"type": ["string", "null"]},
          "reconciliation_role": {"enum": ["broker_reconciling", "additive", "overlay", "research_only", "detail_only"]},
          "exposure_basis": {"enum": ["broker_quantity", "attribution", "pair_detail", "delta_overlay", "research"]},
          "metrics": {"type": "object"},
          "lineage": {"type": "object"}
        }
      }
    }
  }
}
